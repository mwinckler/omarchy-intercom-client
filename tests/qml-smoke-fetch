#!/usr/bin/env python3
"""Deterministic subprocess responses for the QML smoke test; never use the API."""

import json
import os
import signal
import sys
import time

args = sys.argv[1:]
if "--spam" in args:
    print(json.dumps({
        "state": "error",
        "message": "Mark as spam requires the Read and write users permission, which is separate from Write users and companies. Enable Read and write users on the Intercom app, then sign in again.",
    }))
    sys.exit(0)
if os.environ.get("INTERCOM_SMOKE_SLOW_CLOSED") and "--inbox" in args and args[args.index("--inbox") + 1] == "closed":
    def finish_cancelled(signum, frame):
        # Simulate a late successful response while the old tab is being canceled.
        print(json.dumps({"state": "ready", "workspaceId": "smoke", "conversations": [{"id": "stale-closed", "state": "closed"}]}))
        sys.exit(0)
    signal.signal(signal.SIGTERM, finish_cancelled)
    time.sleep(10)
conversation = {}
if "--conversation" in args:
    conversation = {
        "id": args[args.index("--conversation") + 1],
        "state": "open",
        "messages": [],
    }

print(json.dumps({
    "state": "ready",
    "workspaceId": "smoke",
    "waitingCount": 0,
    "openCount": 0,
    "conversations": [],
    "conversation": conversation,
}))
