HTML_TAG = re.compile(r"<[^>]+>", re.S)
HTML_MARKUP = re.compile(r"</?[A-Za-z][^>]*>", re.S)
WHITESPACE = re.compile(r"\s+")
BARE_URL = re.compile(r"https?://[^\s<>\"']+", re.I)
TRAILING_URL_PUNCT = re.compile(r"[.,;:!?]+$")
WORKSPACE_IN_URL = re.compile(r"/a/(?:inbox|apps)/([^/]+)/", re.I)
WORKSPACE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{1,63}$")
CONVERSATION_ID = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
RESERVED_WORKSPACE = {
    "inbox",
    "apps",
    "shared",
    "all",
    "conversation",
    "conversations",
    "admin",
    "home",
}


