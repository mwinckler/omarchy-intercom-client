    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    token_file = args.token_file.strip() or None
    if args.save_oauth and args.login:
        saved = save_oauth(sys.stdin.readline())
        payload = saved if saved.get("state") == "error" else oauth_login(token_file)
    elif args.save_oauth:
        payload = save_oauth(sys.stdin.readline())
    elif args.login:
        payload = oauth_login(token_file)
    elif args.logout:
        payload = logout(token_file)
    elif args.save_token:
        payload = save_token(sys.stdin.readline(), token_file, args.workspace)
    elif args.sync:
        payload = sync_conversations(token_file)
    elif str(args.search or "").strip():
        payload = search_conversations(
            token_file,
            args.search,
            args.remote,
            max(1, min(SEARCH_LIMIT, args.limit)),
        )
    elif str(args.reopen or "").strip():
        payload = reopen_conversation(token_file, args.reopen)
    elif str(args.close or "").strip():
        payload = close_conversation(token_file, args.close)
    elif str(args.reply or "").strip():
        payload = reply_conversation(token_file, args.reply, sys.stdin.readline())
    elif args.workspace is not None:
        workspace = parse_workspace_id(args.workspace)
        if not workspace:
            payload = result_payload(
                "error",
                "Could not read a workspace ID. Paste the Intercom inbox URL from your browser.",
            )
        else:
            try:
                save_config(workspaceId=workspace)
                payload = result_payload("saved", f"Saved workspace {workspace} to {config_path()}")
            except OSError as error:
                payload = result_payload("error", f"Could not save workspace: {error.strerror or error}")
    elif str(args.panel or "").strip() or str(args.filter or "").strip() or str(args.viewed or "").strip():
        payload = save_prefs(args.panel, args.filter, args.viewed)
    elif str(args.conversation or "").strip():
        payload = fetch_thread(token_file, args.conversation)
    elif str(args.inbox or "").strip():
        payload = fetch_inbox(token_file, args.inbox, max(1, min(150, args.limit)))
    elif args.open:
        payload = fetch_open(token_file, max(1, min(150, args.limit)))
    else:
        payload = fetch(token_file, max(1, min(150, args.limit)))
    json.dump(payload, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
