def post_conversation_part(token_file: str | None, conversation_id: str, message_type: str) -> dict:
    token = read_token(token_file)
    if not token:
        return unconfigured_payload(token_file)
    conv_id = str(conversation_id or "").strip()
    if not CONVERSATION_ID.fullmatch(conv_id):
        return result_payload("error", "Missing conversation id.")
    config = load_config()
    last_error: ApiError | None = None
    for region in region_order(config.get("region")):
        base = api_base_for_region(region)
        try:
            me_payload = request_json(f"{base}/me", token)
        except ApiError as error:
            last_error = error
            if is_missing_permission(error):
                return missing_admin_payload()
            if is_wrong_region(error) or error.status in (401, 403, 404):
                continue
            return result_payload("error", str(error))
        me = parse_me(me_payload)
        admin_id = str(me.get("id") or "")
        if not admin_id:
            return missing_admin_payload()
        persist_admin(me)
        if me.get("region"):
            region = str(me["region"])
            base = api_base_for_region(region)
        try:
            payload = request_json(
                f"{base}/conversations/{urllib.parse.quote(conv_id, safe='')}/parts",
                token,
                method="POST",
                payload=admin_part_body(admin_id, message_type),
            )
        except ApiError as error:
            last_error = error
            if is_missing_permission(error):
                return missing_write_payload()
            return result_payload("error", str(error))
        workspace = parse_workspace_id(
            me.get("workspaceId") or config.get("workspaceId") or workspace_from_payload(payload)
        )
        try:
            save_config(region=region, workspaceId=workspace or None)
        except OSError:
            pass
        conversation = normalize_thread(payload, region, workspace)
        wanted_state = "open" if str(message_type or "").strip().lower() == "open" else "closed"
        if conversation.get("id") != conv_id:
            conversation = {
                "id": conv_id,
                "title": "",
                "url": conversation_url(region, workspace, conv_id),
                "waitingSince": 0,
                "state": wanted_state,
                "messages": [],
            }
        else:
            conversation["state"] = wanted_state
        return result_payload(
            "ready",
            "",
            inboxUrl=inbox_url(region, workspace),
            workspaceId=workspace,
            conversation=conversation,
        )
    if last_error and is_missing_permission(last_error):
        return missing_write_payload()
    return region_failure_payload(last_error)


def sync_status_payload(
    state: str,
    message: str,
    scanned: int = 0,
    stored: int = 0,
    skipped: int = 0,
    failed: int = 0,
    total: int = 0,
    synced_at: int = 0,
    **fields: object,
) -> dict:
    payload = {
        "state": state,
        "message": message,
        "scanned": max(0, int(scanned)),
        "stored": max(0, int(stored)),
        "skipped": max(0, int(skipped)),
        "failed": max(0, int(failed)),
        "total": max(0, int(total)),
        "syncedAt": max(0, int(synced_at)),
    }
    payload.update(fields)
    return payload


def write_sync_status(payload: dict) -> None:
    write_json_file(archive_status_path(), payload)


def load_archive_index() -> dict[str, dict]:
    parsed = read_json_file(archive_index_path())
    if not isinstance(parsed, dict):
        return {}
    conversations = parsed.get("conversations")
    if not isinstance(conversations, dict):
        return {}
    index: dict[str, dict] = {}
    for key, value in conversations.items():
        conv_id = str(key or "").strip()
        if not CONVERSATION_ID.fullmatch(conv_id) or not isinstance(value, dict):
            continue
        index[conv_id] = value
    return index


def save_archive_index(index: dict[str, dict], synced_at: int) -> None:
    write_json_file(
        archive_index_path(),
        {
            "syncedAt": max(0, int(synced_at)),
            "count": len(index),
            "conversations": index,
        },
    )


def archive_thread_stored(conversation_id: str) -> bool:
    return os.path.isfile(archive_thread_path(conversation_id))


def store_archive_thread(record: dict) -> None:
    conv_id = str(record.get("id") or "").strip()
    if not CONVERSATION_ID.fullmatch(conv_id):
        raise ValueError("Missing conversation id.")
    write_json_file(archive_thread_path(conv_id), record)


def fetch_archive_thread(token: str, region: str, conv_id: str) -> dict | None:
    try:
        return fetch_conversation(token, region, conv_id)
    except ApiError:
        return None


def sync_search_page(
    token: str,
    region: str,
    workspace: str,
    rows: list[object],
    index: dict[str, dict],
) -> tuple[int, int, int, int]:
    scanned = stored = skipped = failed = 0
    to_fetch: list[str] = []
    for item in rows:
        if not isinstance(item, dict):
            continue
        conv_id = str(item.get("id") or "").strip()
        if not CONVERSATION_ID.fullmatch(conv_id):
            continue
        scanned += 1
        already = archive_thread_stored(conv_id)
        if not should_fetch_archive_thread(conversation_state(item), already):
            if conv_id not in index:
                index[conv_id] = archive_index_row(archive_thread_record(item, region, workspace))
            skipped += 1
            continue
        to_fetch.append(conv_id)
    details: dict[str, dict] = {}
    if to_fetch:
        workers = max(1, min(DETAIL_WORKERS, len(to_fetch)))
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
            futures = {
                pool.submit(fetch_archive_thread, token, region, conv_id): conv_id
                for conv_id in to_fetch
            }
            for future in concurrent.futures.as_completed(futures):
                conv_id = futures[future]
                try:
                    payload = future.result()
                except Exception:
                    payload = None
                if isinstance(payload, dict):
                    details[conv_id] = payload
    for conv_id in to_fetch:
        payload = details.get(conv_id)
        if not isinstance(payload, dict) or str(payload.get("id") or "").strip() != conv_id:
            failed += 1
            continue
        try:
            record = archive_thread_record(payload, region, workspace)
            store_archive_thread(record)
            index[conv_id] = archive_index_row(record)
            stored += 1
        except (OSError, ValueError):
            failed += 1
    return scanned, stored, skipped, failed


def sync_conversations(token_file: str | None = None) -> dict:
    token = read_token(token_file)
    if not token:
        payload = unconfigured_payload(token_file)
        return sync_status_payload(
            "unconfigured",
            str(payload.get("message") or "Sign in with Intercom to connect this plugin."),
        )
    found = search_first_region(token, search_all_body(SYNC_PAGE_SIZE))
    if not found.get("ok"):
        message = str(found.get("message") or "Could not list Intercom conversations.")
        state = str(found.get("state") or "error")
        status = sync_status_payload(state, message)
        try:
            write_sync_status(status)
        except OSError:
            pass
        return status
    region = str(found.get("region") or "US")
    workspace = str(found.get("workspace") or "")
    me = found.get("me") if isinstance(found.get("me"), dict) else None
    first = found.get("payload") if isinstance(found.get("payload"), dict) else {}
    try:
        total = max(0, int(first.get("total_count") or 0))
    except (TypeError, ValueError):
        total = 0
    index = load_archive_index()
    scanned = stored = skipped = failed = 0
    page = first
    pages = 0
    synced_at = int(time.time())
    status = sync_status_payload(
        "syncing",
        "Syncing conversations…",
        total=total,
        synced_at=synced_at,
        **identity_from_me(me),
    )
    try:
        write_sync_status(status)
    except OSError as error:
        return sync_status_payload("error", f"Could not write archive: {error.strerror or error}")
    while pages < MAX_SYNC_PAGES:
        pages += 1
        rows = page.get("conversations") if isinstance(page.get("conversations"), list) else []
        page_scanned, page_stored, page_skipped, page_failed = sync_search_page(
            token,
            region,
            workspace,
            rows,
            index,
        )
        scanned += page_scanned
        stored += page_stored
        skipped += page_skipped
        failed += page_failed
        if total < scanned:
            total = scanned
        status = sync_status_payload(
            "syncing",
            f"Syncing {scanned} of {total}…" if total else f"Syncing {scanned} conversations…",
            scanned=scanned,
            stored=stored,
            skipped=skipped,
            failed=failed,
            total=total,
            synced_at=synced_at,
            **identity_from_me(me),
        )
        try:
            write_sync_status(status)
            save_archive_index(index, synced_at)
        except OSError as error:
            return sync_status_payload("error", f"Could not write archive: {error.strerror or error}")
        cursor = search_next_cursor(page)
        if not cursor:
            break
        try:
            page = request_json(
                f"{api_base_for_region(region)}/conversations/search",
                token,
                method="POST",
                payload=search_all_body(SYNC_PAGE_SIZE, cursor),
            )
        except ApiError as error:
            if is_missing_permission(error):
                status = missing_permission_payload()
                message = str(status.get("message") or str(error))
                result = sync_status_payload("error", message, scanned, stored, skipped, failed, total, synced_at)
                try:
                    write_sync_status(result)
                except OSError:
                    pass
                return result
            result = sync_status_payload("error", str(error), scanned, stored, skipped, failed, total, synced_at)
            try:
                write_sync_status(result)
            except OSError:
                pass
            return result
    if failed and stored == 0 and skipped == 0:
        message = "Could not store Intercom conversations."
        result = sync_status_payload("error", message, scanned, stored, skipped, failed, total, synced_at)
    else:
        message = f"Synced {len(index)} conversations."
        if skipped:
            message = f"Synced {len(index)} conversations ({skipped} closed already stored)."
        result = sync_status_payload(
            "ready",
            message,
            scanned,
            stored,
            skipped,
            failed,
            total,
            synced_at,
            **identity_from_me(me),
        )
    try:
        write_sync_status(result)
        save_archive_index(index, synced_at)
    except OSError as error:
        return sync_status_payload("error", f"Could not write archive: {error.strerror or error}")
    return result


def archive_row_haystack(row: dict) -> str:
    parts = [
        row.get("id"),
        row.get("title"),
        row.get("from"),
        row.get("email"),
        row.get("snippet"),
        row.get("state"),
    ]
    messages = row.get("messages")
    if isinstance(messages, list):
        for msg in messages:
            if not isinstance(msg, dict):
                continue
            parts.extend([msg.get("body"), msg.get("from"), msg.get("email")])
    return " ".join(str(part or "") for part in parts).lower()


def haystack_matches(haystack: str, tokens: list[str]) -> bool:
    if not tokens:
        return False
    text = str(haystack or "").lower()
    return all(token in text for token in tokens)


def search_archive_local(query: str, limit: int = SEARCH_LIMIT) -> list[dict]:
    tokens = search_tokens(query)
    cap = max(1, min(SEARCH_LIMIT, int(limit)))
    if not tokens:
        return []
    hits: list[dict] = []
    seen: set[str] = set()
    for conv_id, row in load_archive_index().items():
        if not isinstance(row, dict):
            continue
        if not haystack_matches(archive_row_haystack(row), tokens):
            continue
        hits.append(archive_index_row(row if row.get("id") else {**row, "id": conv_id}))
        seen.add(conv_id)
        if len(hits) >= cap:
            return hits
    threads_dir = os.path.join(archive_dir(), "threads")
    try:
        names = os.listdir(threads_dir)
    except OSError:
        return hits
    for name in names:
        if len(hits) >= cap:
            break
        if not name.endswith(".json"):
            continue
        conv_id = name[:-5]
        if conv_id in seen or not CONVERSATION_ID.fullmatch(conv_id):
            continue
        path = os.path.join(threads_dir, name)
        try:
            with open(path, encoding="utf-8") as handle:
                text = handle.read()
        except OSError:
            continue
        if not haystack_matches(text, tokens):
            continue
        parsed = read_json_file(path)
        if not isinstance(parsed, dict):
            continue
        hits.append(archive_index_row(parsed))
        seen.add(conv_id)
    return hits


def search_conversations(token_file: str | None, query: str, remote: bool = False, limit: int = SEARCH_LIMIT) -> dict:
    text = str(query or "").strip()
    if not text:
        return result_payload("error", "Type a search query.")
    cap = max(1, min(SEARCH_LIMIT, int(limit)))
    if not remote:
        conversations = search_archive_local(text, cap)
        return result_payload(
            "ready",
            "" if conversations else "No local conversations matched.",
            conversations=conversations,
            openCount=len(conversations),
        )
    token = read_token(token_file)
    if not token:
        return unconfigured_payload(token_file)
    found = search_first_region(token, search_remote_body(text, cap))
    if not found.get("ok"):
        return found
    payload = found.get("payload") if isinstance(found.get("payload"), dict) else {}
    parsed = parse_search_results(payload, found["region"], found["workspace"], cap)
    me = found.get("me") if isinstance(found.get("me"), dict) else None
    return result_payload(
        "ready",
        "" if parsed["conversations"] else "No Intercom conversations matched.",
        conversations=parsed["conversations"],
        openCount=parsed["openCount"],
        waitingCount=parsed["waitingCount"],
        inboxUrl=inbox_url(found["region"], found["workspace"]),
        workspaceId=found["workspace"],
        **identity_from_me(me),
    )


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
