    }


def sort_waiting(conversations: list[dict]) -> list[dict]:
    return sorted(conversations, key=lambda row: (-(row.get("waitingSince") or 0), row.get("id") or ""))


def sort_open(conversations: list[dict]) -> list[dict]:
    return sorted(
        conversations,
        key=lambda row: (-(row.get("updatedAt") or 0), row.get("id") or ""),
    )


def parse_search(payload: dict, region: str, workspace_id: str, limit: int) -> dict:
    raw = payload.get("conversations") if isinstance(payload.get("conversations"), list) else []
    conversations = []
    skipped_snoozed = 0
    for item in raw:
        if not isinstance(item, dict):
            continue
        if is_snoozed(item) and waiting_since_of(item) > 0:
            skipped_snoozed += 1
        row = normalize_conversation(item, region, workspace_id)
        if row:
            conversations.append(row)
    conversations = sort_waiting(conversations)[: max(0, int(limit))]
    total = payload.get("total_count")
    try:
        waiting_count = int(total)
    except (TypeError, ValueError):
        waiting_count = len(conversations)
    if skipped_snoozed:
        waiting_count = max(0, waiting_count - skipped_snoozed)
    if waiting_count < len(conversations):
        waiting_count = len(conversations)
    return {
        "waitingCount": waiting_count,
        "conversations": conversations,
    }


def parse_inbox_search(
    payload: dict,
    region: str,
    workspace_id: str,
    limit: int,
    inbox_filter: str = "open",
) -> dict:
    mode = filter_mode(inbox_filter)
    if mode == "waiting":
        mode = "open"
    raw = payload.get("conversations") if isinstance(payload.get("conversations"), list) else []
    conversations = []
    skipped = 0
    for item in raw:
        if not isinstance(item, dict):
            continue
        state = conversation_state(item)
        if mode == "open" and state != "open":
            skipped += 1
            continue
        if mode == "closed" and state != "closed":
            continue
        if mode == "snoozed" and state != "snoozed":
            continue
        row = normalize_search_conversation(item, region, workspace_id)
        if row:
            if mode == "snoozed":
                row["state"] = "snoozed"
            conversations.append(row)
    conversations = sort_open(conversations)[: max(0, int(limit))]
    total = payload.get("total_count")
    try:
        count = int(total)
    except (TypeError, ValueError):
        count = len(conversations)
    if mode == "open" and skipped:
        count = max(0, count - skipped)
    if count < len(conversations):
        count = len(conversations)
    waiting_count = sum(1 for row in conversations if (row.get("waitingSince") or 0) > 0)
    return {
        "inboxCount": count,
        "openCount": count if mode == "open" else 0,
        "waitingCount": waiting_count,
        "conversations": conversations,
    }


def parse_open_search(payload: dict, region: str, workspace_id: str, limit: int) -> dict:
    parsed = parse_inbox_search(payload, region, workspace_id, limit, "open")
    return {
        "openCount": parsed["openCount"] or parsed["inboxCount"],
        "waitingCount": parsed["waitingCount"],
        "conversations": parsed["conversations"],
    }


def parse_search_results(payload: dict, region: str, workspace_id: str, limit: int) -> dict:
