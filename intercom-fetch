    for item in raw:
        if not isinstance(item, dict):
            continue
        row = normalize_search_conversation(item, region, workspace_id)
        if row:
            conversations.append(row)
    conversations = sort_open(conversations)[: max(0, int(limit))]
    total = payload.get("total_count")
    try:
        count = int(total)
    except (TypeError, ValueError):
        count = len(conversations)
    return {
        "openCount": count,
        "waitingCount": sum(1 for row in conversations if (row.get("waitingSince") or 0) > 0),
        "conversations": conversations,
    }


def error_fields(body: str) -> tuple[str, str]:
    try:
        parsed = json.loads(body)
    except json.JSONDecodeError:
        return "", ""
    if not isinstance(parsed, dict):
        return "", ""
    errors = parsed.get("errors")
    first = errors[0] if isinstance(errors, list) and errors and isinstance(errors[0], dict) else {}
    return str(first.get("code") or ""), str(first.get("message") or "").strip()


def is_wrong_region(error: ApiError) -> bool:
    code, message = error_fields(error.body)
    return error.status == 401 and code == "unauthorized" and "Access Token Invalid" in message


def is_missing_permission(error: ApiError) -> bool:
    code, message = error_fields(error.body)
    return code == "token_unauthorized" or "Not authorized to access resource" in message


def is_revoked_token(error: ApiError) -> bool:
    return error.status == 401 and not is_missing_permission(error)


def config_path() -> str:
    return os.path.join(os.path.dirname(default_token_path()), "config.json")


def normalize_panel_mode(value: object) -> str:
    text = str(value or "").strip().lower()
    return "large" if text == "large" else "expanded"


def load_config() -> dict:
    try:
        with open(config_path(), encoding="utf-8") as handle:
            parsed = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(parsed, dict):
        return {}
    if "panel" in parsed:
        parsed["panel"] = normalize_panel_mode(parsed.get("panel"))
    return parsed


def save_config(**fields: object) -> None:
    data = load_config()
    for key, value in fields.items():
        if value is None:
            continue
        data[key] = value
    path = config_path()
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    os.chmod(directory, 0o700)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(data, handle)
        handle.write("\n")
    os.chmod(path, 0o600)


def write_json_file(path: str, data: object) -> None:
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    os.chmod(directory, 0o700)
    tmp = f"{path}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(data, handle, ensure_ascii=False, separators=(",", ":"))
        handle.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def read_json_file(path: str) -> object:
