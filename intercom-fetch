def region_order(preferred: str | None = None) -> list[str]:
    order: list[str] = []
    if preferred:
        region = str(preferred).upper()
        if region in REGION_HOSTS:
            order.append(region)
    for region in ("US", "EU", "AU"):
        if region not in order:
            order.append(region)
    return order


def summarize_error(status: int, body: str) -> str:
    code, message = error_fields(body)
    if message:
        if code == "token_unauthorized":
            return (
                "Token is missing a permission Intercom requires for this request. "
                "Read conversations lists threads; Write conversations is required to reply or close."
            )
        return message
    if status == 401:
        return "Intercom rejected the access token."
    if status == 403:
        return "Intercom token is missing a required permission."
    if status:
        return f"Intercom request failed ({status})."
    text = (body or "").strip()
    if text:
        return f"Intercom request failed: {text}"
    return "Intercom request failed."


def request_json(
    url: str,
    token: str,
    method: str = "GET",
    payload: dict | None = None,
    version: str | None = None,
) -> dict:
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("Accept", "application/json")
    req.add_header("Intercom-Version", version or INTERCOM_VERSION)
    if payload is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_SEC) as response:
            body = response.read().decode("utf-8")
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")
        raise ApiError(error.code, body, url) from None
    except urllib.error.URLError as error:
        raise ApiError(0, str(error.reason or error), url) from None
    try:
        parsed = json.loads(body) if body else {}
    except json.JSONDecodeError as error:
        raise ApiError(0, "Intercom returned invalid JSON.", url) from error
    if not isinstance(parsed, dict):
        raise ApiError(0, "Intercom returned invalid JSON.", url)
    return parsed


def request_form(url: str, payload: dict) -> dict:
    data = urllib.parse.urlencode(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, method="POST")
    req.add_header("Accept", "application/json")
    req.add_header("Content-Type", "application/x-www-form-urlencoded")
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_SEC) as response:
            body = response.read().decode("utf-8")
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")
        raise ApiError(error.code, body, url) from None
    except urllib.error.URLError as error:
        raise ApiError(0, str(error.reason or error), url) from None
    try:
        parsed = json.loads(body) if body else {}
    except json.JSONDecodeError as error:
        raise ApiError(0, "Intercom returned invalid JSON.", url) from error
    if not isinstance(parsed, dict):
        raise ApiError(0, "Intercom returned invalid JSON.", url)
    return parsed


