def is_word_char(value: str) -> bool:
    if not value:
        return False
    return ("0" <= value <= "9") or ("A" <= value <= "Z") or ("a" <= value <= "z")


def _is_code_fence(line: str) -> bool:
    return line.lstrip().startswith("```")


def _preformatted(lines: list[str]) -> str:
    return f"<pre><code>{html.escape('\n'.join(lines))}</code></pre>"


def markdown_to_html(value: object) -> str:
    text = str(value or "").replace("\r\n", "\n").replace("\r", "\n")
    if not text.strip():
        return ""
    chunks: list[str] = []
    in_code = False
    code_lines: list[str] = []

    def append_piece(piece: str) -> None:
        if chunks:
            chunks.append("<br>")
        chunks.append(piece)

    for line in text.split("\n"):
        if _is_code_fence(line):
            if in_code:
                append_piece(_preformatted(code_lines))
                code_lines = []
                in_code = False
            else:
                in_code = True
            continue
        if in_code:
            code_lines.append(line)
            continue
        append_piece(_markdown_inline(line))
    if in_code:
        append_piece(_preformatted(code_lines))
    styled = "".join(chunks)
    if not message_plain_text(styled):
        return ""
    return styled


def _markdown_inline(text: str) -> str:
    out: list[str] = []
    i = 0
    length = len(text)
    while i < length:
        if text[i] == "`":
            end = text.find("`", i + 1)
            if end != -1:
                out.append(f"<code>{html.escape(text[i + 1 : end])}</code>")
                i = end + 1
                continue
        if text.startswith("**", i) or text.startswith("__", i):
            mark = text[i : i + 2]
            end = text.find(mark, i + 2)
            if end != -1:
                out.append(f"<b>{html.escape(text[i + 2 : end])}</b>")
                i = end + 2
                continue
        if text[i] == "*" and not text.startswith("**", i):
            end = text.find("*", i + 1)
            if end > i + 1:
                out.append(f"<i>{html.escape(text[i + 1 : end])}</i>")
                i = end + 1
                continue
        if text[i] == "_" and not text.startswith("__", i) and (i == 0 or not is_word_char(text[i - 1])):
            end = text.find("_", i + 1)
            if end > i + 1 and (end + 1 >= length or not is_word_char(text[end + 1])):
                out.append(f"<i>{html.escape(text[i + 1 : end])}</i>")
                i = end + 1
                continue
        if text[i] == "[":
            close = text.find("](", i + 1)
            finish = text.find(")", close + 2) if close != -1 else -1
            if close != -1 and finish > close:
                label = text[i + 1 : close]
                href = is_safe_http_url(text[close + 2 : finish].strip())
                if href:
                    out.append(
                        f'<a href="{html.escape(href, quote=True)}">{html.escape(label)}</a>'
                    )
                    i = finish + 1
                    continue
        out.append(html.escape(text[i]))
        i += 1
    return "".join(out)


def admin_reply_body(admin_id: str, body: str, message_type: str = "comment") -> dict:
    kind = "note" if str(message_type or "").strip().lower() == "note" else "comment"
    return {
        "message_type": kind,
        "type": "admin",
        "admin_id": str(admin_id),
        "body": body,
    }


def admin_part_body(admin_id: str, message_type: str) -> dict:
    kind = "open" if str(message_type or "").strip().lower() == "open" else "close"
    return {
        "message_type": kind,
        "type": "admin",
        "admin_id": str(admin_id),
    }


def admin_close_body(admin_id: str) -> dict:
    return admin_part_body(admin_id, "close")


def admin_open_body(admin_id: str) -> dict:
    return admin_part_body(admin_id, "open")


def conversation_title(conv: dict) -> str:
    title = str(conv.get("title") or "").strip()
    if title:
        return title
    source = conv.get("source") if isinstance(conv.get("source"), dict) else {}
    subject = str(source.get("subject") or "").strip()
    if subject:
        return subject
    author = source.get("author") if isinstance(source.get("author"), dict) else {}
    name = str(author.get("name") or "").strip()
    if name:
        return name
    contacts = conv.get("contacts") if isinstance(conv.get("contacts"), dict) else {}
    people = contacts.get("contacts") if isinstance(contacts.get("contacts"), list) else []
    if people and isinstance(people[0], dict):
        name = str(people[0].get("name") or "").strip()
        if name:
            return name
    conv_id = str(conv.get("id") or "").strip()
    return f"Conversation {conv_id}" if conv_id else "Conversation"


def unix_time(value: object) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def author_email(author: object) -> str:
    if not isinstance(author, dict):
        return ""
    email = str(author.get("email") or "").strip()
    return email if "@" in email else ""


def author_name(author: object) -> str:
    if not isinstance(author, dict):
        return ""
    name = str(author.get("name") or "").strip()
    email = author_email(author)
    if not name:
        return ""
    if email and name.lower() == email.lower():
        return ""
    return name


def author_fallback(author: object) -> str:
    if not isinstance(author, dict):
        return ""
    kind = str(author.get("type") or "").strip().lower()
    if kind in ("admin", "team"):
        return "Teammate"
    if kind in ("bot", "operator", "ai_agent"):
        return "Bot"
    if kind in ("user", "lead", "visitor", "contact"):
        return "Customer"
    return kind.capitalize() if kind else ""


def author_label(author: object) -> str:
    name = author_name(author)
    if name:
        return name
    email = author_email(author)
    if email:
        return email
    return author_fallback(author)


def author_email_for_display(author: object) -> str:
    email = author_email(author)
    if not email or author_label(author) == email:
        return ""
    return email


def conversation_parts_list(conv: dict) -> list[dict]:
    parts = conv.get("conversation_parts")
    if isinstance(parts, dict):
        items = parts.get("conversation_parts")
        return [item for item in items if isinstance(item, dict)] if isinstance(items, list) else []
    if isinstance(parts, list):
        return [item for item in parts if isinstance(item, dict)]
    return []


def conversation_parts_total(conv: dict) -> int:
    parts = conv.get("conversation_parts")
    if not isinstance(parts, dict):
        return 0
    try:
        return max(0, int(parts.get("total_count") or 0))
    except (TypeError, ValueError):
        return 0


def parts_next_cursor(conv: dict) -> str:
    parts = conv.get("conversation_parts")
    if not isinstance(parts, dict):
        return ""
    pages = parts.get("pages") if isinstance(parts.get("pages"), dict) else {}
    nxt = pages.get("next")
    if isinstance(nxt, dict):
        return str(nxt.get("starting_after") or nxt.get("starting_after_id") or "").strip()
    if isinstance(nxt, str):
        return nxt.strip()
    return str(pages.get("next") or "").strip()


def search_next_cursor(payload: dict) -> str:
    pages = payload.get("pages") if isinstance(payload.get("pages"), dict) else {}
    nxt = pages.get("next")
    if isinstance(nxt, dict):
        return str(nxt.get("starting_after") or nxt.get("starting_after_id") or "").strip()
    if isinstance(nxt, str):
