    parser.add_argument("--token-file", default="", help="Path to the Intercom access token file")
    parser.add_argument(
        "--save-token",
        action="store_true",
        help="Read a token from stdin and save it to the token file (mode 0600)",
    )
    parser.add_argument(
        "--save-oauth",
        action="store_true",
        help="Read Intercom OAuth client ID and secret JSON from stdin and save it (mode 0600)",
    )
    parser.add_argument(
        "--login",
        action="store_true",
        help="Sign in with Intercom via OAuth and save the per-user access token",
    )
    parser.add_argument(
        "--logout",
        action="store_true",
        help="Remove the saved Intercom access token and sign out",
    )
    parser.add_argument(
        "--reply",
        default="",
        help="Send a Markdown reply to a conversation id (body on stdin)",
    )
    parser.add_argument(
        "--close",
        default="",
        help="Close a conversation id as the signed-in teammate",
    )
    parser.add_argument(
        "--reopen",
        default="",
        help="Reopen a closed conversation id as the signed-in teammate",
    )
    parser.add_argument(
        "--sync",
        action="store_true",
        help="Fetch all conversations, including closed, into a local archive",
    )
    parser.add_argument(
        "--search",
        default="",
        help="Search conversations in the local archive (or Intercom with --remote)",
    )
    parser.add_argument(
        "--remote",
        action="store_true",
        help="Search via the Intercom API instead of the local archive",
    )
    parser.add_argument(
        "--workspace",
        default=None,
        help="Intercom workspace ID from the inbox URL (saved next to the token)",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=DEFAULT_LIMIT,
        help="Maximum conversations to list (1-150)",
    )
    parser.add_argument(
        "--open",
        action="store_true",
        help="List recent open conversations that are not snoozed",
    )
    parser.add_argument(
        "--inbox",
        default="",
        help="List conversations for a filter: open, waiting, closed, snoozed, all",
    )
    parser.add_argument(
        "--conversation",
        default="",
        help="Fetch all messages for a conversation id",
    )
    parser.add_argument(
        "--panel",
        default="",
        help="Save expanded or large as the default panel",
