def conversation_state(conv: dict) -> str:
    state = str(conv.get("state") or "").strip().lower()
    if state == "closed":
        return "closed"
    if state == "snoozed" or is_snoozed(conv):
        return "snoozed"
    if state == "open":
        return "open"
    if conv.get("open") is False:
        return "closed"
    return "open"


def should_fetch_archive_thread(state: object, stored: bool) -> bool:
    return not (stored and str(state or "").strip().lower() == "closed")


def archive_thread_record(conv: dict, region: str, workspace_id: str) -> dict:
    thread = normalize_thread(conv, region, workspace_id)
    sender, email, snippet = conversation_identity(conv)
    thread["from"] = sender
    thread["email"] = email
    thread["snippet"] = snippet
    thread["state"] = conversation_state(conv)
    thread["updatedAt"] = unix_time(conv.get("updatedAt") or conv.get("updated_at")) or unix_time(
        conv.get("created_at")
    )
    return thread


