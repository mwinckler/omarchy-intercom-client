def is_snoozed(conv: dict, now: int | None = None) -> bool:
    if str(conv.get("state") or "").strip().lower() == "snoozed":
        return True
    until = unix_time(conv.get("snoozed_until"))
    if until <= 0:
        return False
    if now is None:
        now = int(time.time())
    return until > now


def waiting_since_of(conv: dict) -> int:
    try:
        value = int(conv.get("waiting_since") or 0)
    except (TypeError, ValueError):
        return 0
    return value if value > 0 else 0


def normalize_conversation(conv: dict, region: str, workspace_id: str) -> dict | None:
    conv_id = str(conv.get("id") or "").strip()
    waiting_since = waiting_since_of(conv)
    if not conv_id or waiting_since <= 0 or is_snoozed(conv):
        return None
    sender, email, snippet = conversation_identity(conv)
    return {
        "id": conv_id,
        "title": conversation_title(conv),
        "from": sender,
        "email": email,
        "snippet": snippet,
        "url": conversation_url(region, workspace_id, conv_id),
        "waitingSince": waiting_since,
        "updatedAt": unix_time(conv.get("updated_at")) or unix_time(conv.get("created_at")),
        "messages": extract_messages(conv),
    }


