    return str(pages.get("next") or "").strip()


def author_type(author: object) -> str:
    if not isinstance(author, dict):
        return ""
    return str(author.get("type") or "").strip().lower()


def is_bot_author(author: object) -> bool:
    return author_type(author) in ("bot", "operator", "ai_agent")


def is_message_part(part_type: str, author: object, public_only: bool = False) -> bool:
    kind = str(part_type or "").strip().lower()
    if kind not in MESSAGE_PART_TYPES:
        return False
    if kind in NOTE_PART_TYPES:
        return not public_only
    if kind in ASSIGN_PART_TYPES:
        # Intercom types a teammate reply that also assigns/reopens as assignment,
        # not comment. Bot-only assignment events ("Assigned to inbox") stay hidden.
        return not is_bot_author(author)
    return True


def message_kind(part_type: str, author: object) -> str:
    if str(part_type or "").strip().lower() in NOTE_PART_TYPES:
        return "note"
    if not isinstance(author, dict):
        return "customer"
    kind = author_type(author)
    if kind in ("admin", "team"):
        return "teammate"
    if kind in ("bot", "operator", "ai_agent"):
        return "bot"
    return "customer"


def extract_messages(conv: dict) -> list[dict]:
    messages: list[dict] = []
    seen: set[str] = set()

    def add(message_id: str, author: object, part_type: str, created: int, body: str) -> None:
        text = format_message_body(body)
        if not text:
            return
        key = str(message_id or "").strip() or f"{created}:{text[:80]}"
        if key in seen:
            return
        seen.add(key)
        messages.append({
            "id": key,
            "from": author_label(author),
            "email": author_email_for_display(author),
            "kind": message_kind(part_type, author),
            "createdAt": max(0, int(created or 0)),
            "body": text,
        })

    source = conv.get("source") if isinstance(conv.get("source"), dict) else {}
    source_body = source.get("body") or ""
    if source_body:
        created = unix_time(source.get("created_at")) or unix_time(conv.get("created_at"))
        add(str(source.get("id") or "source"), source.get("author"), "", created, source_body)
    for part in conversation_parts_list(conv):
        part_type = str(part.get("part_type") or "").strip().lower()
        author = part.get("author")
        if not is_message_part(part_type, author):
            continue
        created = unix_time(part.get("created_at"))
        add(str(part.get("id") or ""), author, part_type, created, part.get("body") or "")
    messages.sort(key=lambda item: (item.get("createdAt") or 0, item.get("id") or ""))
    return messages


def latest_public_message(conv: dict) -> tuple[object, str]:
    messages: list[tuple[int, object, str]] = []
    source = conv.get("source") if isinstance(conv.get("source"), dict) else {}
    source_body = strip_html(source.get("body") or "")
    if source_body:
        created = unix_time(source.get("created_at")) or unix_time(conv.get("created_at"))
        messages.append((created, source.get("author"), source_body))
    for part in conversation_parts_list(conv):
        author = part.get("author")
        if not is_message_part(part.get("part_type"), author, public_only=True):
            continue
        body = strip_html(part.get("body") or "")
        if not body:
            continue
        messages.append((unix_time(part.get("created_at")), author, body))
    if not messages:
        return None, ""
    messages.sort(key=lambda item: (item[0], item[2]))
    _created, author, body = messages[-1]
    return author, body


def latest_preview(conv: dict) -> tuple[str, str]:
    author, body = latest_public_message(conv)
    if not body:
        return "", ""
    return author_label(author), truncate(body)


def conversation_identity(conv: dict) -> tuple[str, str, str]:
    author, body = latest_public_message(conv)
    if not body:
        source = conv.get("source") if isinstance(conv.get("source"), dict) else {}
        author = source.get("author")
        body = ""
    return author_label(author), author_email_for_display(author), truncate(body) if body else ""


def conversation_snippet(conv: dict) -> str:
