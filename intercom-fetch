def region_failure_payload(last_error: ApiError | None) -> dict:
    if last_error and is_missing_permission(last_error):
        return missing_permission_payload()
    if last_error and is_revoked_token(last_error):
        return revoked_token_payload()
    if last_error:
        return result_payload("error", str(last_error))
    return result_payload("error", "Could not reach Intercom.")


def search_first_region(token: str, body: dict) -> dict:
    config = load_config()
    last_error: ApiError | None = None
    for region in region_order(config.get("region")):
        try:
            payload = request_json(
                f"{api_base_for_region(region)}/conversations/search",
                token,
                method="POST",
                payload=body,
            )
        except ApiError as error:
            last_error = error
            if is_missing_permission(error):
                return missing_permission_payload()
            if is_wrong_region(error) or error.status in (401, 403, 404):
                continue
            return result_payload("error", str(error))
        me = try_identify(token, region)
        persist_admin(me)
        known_ids = [
            str(item.get("id") or "").strip()
            for item in (payload.get("conversations") or [])
            if isinstance(item, dict)
        ]
        workspace = parse_workspace_id(
            (me or {}).get("workspaceId")
            or config.get("workspaceId")
            or workspace_from_payload(payload)
            or discover_workspace(token, region, known_ids)
        )
        if me and me.get("region"):
            region = me["region"]
        try:
            fields: dict[str, object] = {"region": region}
            if workspace:
                fields["workspaceId"] = workspace
            save_config(**fields)
        except OSError:
            pass
        return {
            "ok": True,
            "region": region,
            "workspace": workspace,
            "payload": payload,
            "me": me,
        }
    return region_failure_payload(last_error)


def fetch(token_file: str | None = None, limit: int = DEFAULT_LIMIT) -> dict:
    token = read_token(token_file)
    if not token:
        return unconfigured_payload(token_file)
    found = search_first_region(token, search_body(limit))
    if not found.get("ok"):
        return found
    return fetch_waiting(
        token,
        found["region"],
        found["workspace"],
        limit,
        found["payload"],
        found.get("me") if isinstance(found.get("me"), dict) else None,
    )


def fetch_inbox(
    token_file: str | None = None,
    inbox_filter: str = "open",
    limit: int = DEFAULT_LIMIT,
) -> dict:
    token = read_token(token_file)
    if not token:
        return unconfigured_payload(token_file)
    mode = filter_mode(inbox_filter)
    if mode == "waiting":
        mode = "open"
    found = search_first_region(token, search_inbox_body(mode, limit))
    if not found.get("ok"):
        return found
    payload = found.get("payload") if isinstance(found.get("payload"), dict) else {}
    payload = dict(payload)
    conversations = payload.get("conversations") if isinstance(payload.get("conversations"), list) else []
    payload["conversations"] = attach_latest_messages(token, found["region"], conversations)
    parsed = parse_inbox_search(payload, found["region"], found["workspace"], limit, mode)
    me = found.get("me") if isinstance(found.get("me"), dict) else None
    return result_payload(
        "ready",
        "",
        waitingCount=parsed["waitingCount"],
        openCount=parsed["openCount"],
        inboxCount=parsed["inboxCount"],
        inboxUrl=inbox_url(found["region"], found["workspace"]),
        workspaceId=found["workspace"],
        conversations=parsed["conversations"],
        **identity_from_me(me),
    )


def fetch_open(token_file: str | None = None, limit: int = DEFAULT_LIMIT) -> dict:
    return fetch_inbox(token_file, "open", limit)


def fetch_thread(token_file: str | None, conversation_id: str) -> dict:
    token = read_token(token_file)
    if not token:
        return unconfigured_payload(token_file)
    conv_id = str(conversation_id or "").strip()
    if not conv_id:
        return result_payload("error", "Missing conversation id.")
    config = load_config()
    last_error: ApiError | None = None
    for region in region_order(config.get("region")):
        try:
            payload = request_json(
                f"{api_base_for_region(region)}/conversations/"
                f"{urllib.parse.quote(conv_id, safe='')}",
                token,
            )
        except ApiError as error:
            last_error = error
            if is_missing_permission(error):
                return missing_permission_payload()
            if is_wrong_region(error) or error.status in (401, 403, 404):
                continue
            return result_payload("error", str(error))
        workspace = parse_workspace_id(
            config.get("workspaceId") or workspace_from_payload(payload)
        )
        payload = attach_missing_parts(token, region, conv_id, payload)
        return result_payload(
            "ready",
            "",
            inboxUrl=inbox_url(region, workspace),
            workspaceId=workspace,
            conversation=normalize_thread(payload, region, workspace),
        )
    return region_failure_payload(last_error)


def oauth_path() -> str:
    return os.path.join(os.path.dirname(default_token_path()), "oauth.json")


def load_oauth() -> dict:
    try:
        with open(oauth_path(), encoding="utf-8") as handle:
            parsed = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(parsed, dict):
        return {}
    return {
        "clientId": str(parsed.get("clientId") or parsed.get("client_id") or "").strip(),
        "clientSecret": str(parsed.get("clientSecret") or parsed.get("client_secret") or "").strip(),
    }


def save_oauth(raw: object) -> dict:
    text = str(raw or "").strip()
    incoming: dict = {}
    if text:
        try:
            parsed = json.loads(text)
        except json.JSONDecodeError:
            return result_payload("error", "Could not read Intercom OAuth app credentials.")
        if not isinstance(parsed, dict):
            return result_payload("error", "Could not read Intercom OAuth app credentials.")
        incoming = parsed
    existing = load_oauth()
    client_id = str(
        incoming.get("clientId") or incoming.get("client_id") or existing.get("clientId") or ""
    ).strip()
    client_secret = str(
        incoming.get("clientSecret")
        or incoming.get("client_secret")
        or existing.get("clientSecret")
        or ""
    ).strip()
    if not client_id or not client_secret:
        return result_payload("error", "Paste the Intercom app Client ID and secret first.")
    path = oauth_path()
    directory = os.path.dirname(path)
    try:
        os.makedirs(directory, exist_ok=True)
        os.chmod(directory, 0o700)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump({"clientId": client_id, "clientSecret": client_secret}, handle)
            handle.write("\n")
        os.chmod(path, 0o600)
    except OSError as error:
        return result_payload("error", f"Could not save OAuth credentials: {error.strerror or error}")
    return result_payload("saved", f"Saved OAuth app credentials to {path}")


def oauth_authorize_url(client_id: str, state: str, region: str) -> str:
    query = urllib.parse.urlencode({
        "client_id": client_id,
        "state": state,
        "redirect_uri": OAUTH_REDIRECT,
    })
    return f"{inbox_host_for_region(region)}/oauth?{query}"


def open_browser(url: str) -> bool:
    try:
        subprocess.Popen(
            ["omarchy-launch-browser", url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except OSError:
        return False


class OAuthCallbackServer(HTTPServer):
    def __init__(self, expected_state: str) -> None:
        super().__init__(("127.0.0.1", OAUTH_PORT), OAuthCallbackHandler)
        self.expected_state = expected_state
        self.code = ""
        self.error = ""
        self.finished = threading.Event()


class OAuthCallbackHandler(BaseHTTPRequestHandler):
    def log_message(self, format: str, *args: object) -> None:
        return

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path or "/"
        query = urllib.parse.parse_qs(parsed.query)
        server: OAuthCallbackServer = self.server  # type: ignore[assignment]
        if path in ("/cancel", "/timeout"):
            self._respond(200, "Sign-in cancelled.")
            server.finished.set()
            return
        if path != "/callback":
            self.send_error(404)
            return
        state = (query.get("state") or [""])[0]
        error = (query.get("error") or [""])[0]
        code = (query.get("code") or [""])[0]
        if error:
            server.error = error
        elif state != server.expected_state:
            server.error = "Sign-in state did not match."
        elif not code:
            server.error = "Intercom did not return an authorization code."
        else:
            server.code = code
        self._respond(200, "Signed in. You can close this window and return to Intercom notifier.")
        server.finished.set()

    def _respond(self, status: int, message: str) -> None:
        body = (
            "<!doctype html><meta charset=utf-8><title>Intercom</title>"
            f"<p>{html.escape(message)}</p>"
        ).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def wait_for_oauth_code(expected_state: str) -> tuple[str, str]:
    try:
        httpd = OAuthCallbackServer(expected_state)
    except OSError:
        return "", f"Could not start sign-in (port {OAUTH_PORT} in use)."

    def serve() -> None:
        while not httpd.finished.is_set():
            httpd.timeout = 0.5
            httpd.handle_request()

    thread = threading.Thread(target=serve, daemon=True)
    thread.start()
    if not httpd.finished.wait(LOGIN_TIMEOUT_SEC):
        httpd.error = "Sign-in timed out. Try Sign in with Intercom again."
        httpd.finished.set()
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{OAUTH_PORT}/timeout", timeout=1)
        except Exception:
            pass
    thread.join(2)
    try:
        httpd.server_close()
    except Exception:
        pass
    return httpd.code, httpd.error


def exchange_oauth_code(code: str, client_id: str, client_secret: str) -> str:
    last_error: ApiError | None = None
    for region in region_order(load_config().get("region")):
        url = f"{api_base_for_region(region)}/auth/eagle/token"
        try:
            payload = request_form(
                url,
                {"code": code, "client_id": client_id, "client_secret": client_secret},
            )
        except ApiError as error:
            last_error = error
            if error.status in (401, 403, 404):
                continue
            raise
        token = str(payload.get("token") or payload.get("access_token") or "").strip()
        if token:
            return token
        last_error = ApiError(0, "Intercom did not return an access token.", url)
    if last_error:
        raise last_error
    raise ApiError(0, "Could not reach Intercom.", "")


def logout(token_file: str | None = None) -> dict:
    env_token = os.environ.get("INTERCOM_ACCESS_TOKEN", "").strip()
    errors: list[str] = []
    seen: set[str] = set()
    for path in token_paths(token_file):
        if path in seen:
            continue
        seen.add(path)
        if not os.path.isfile(path):
            continue
        try:
            os.remove(path)
        except OSError as error:
            errors.append(error.strerror or str(error))
    remaining = [path for path in token_paths(token_file) if os.path.isfile(path)]
    if remaining:
        detail = errors[0] if errors else remaining[0]
        return result_payload("error", f"Could not sign out: {detail}")
    try:
        save_config(adminId="", adminName="", adminEmail="")
    except OSError as error:
        return result_payload("error", f"Could not sign out: {error.strerror or error}")
    if env_token:
        return result_payload(
            "error",
            "Removed the saved token, but INTERCOM_ACCESS_TOKEN is still set. "
            "Unset it to finish signing out.",
        )
    return result_payload(
        "unconfigured",
        "Signed out of Intercom. Sign in with Intercom to connect again.",
    )


def oauth_login(token_file: str | None = None) -> dict:
    creds = load_oauth()
    client_id = creds.get("clientId") or ""
    client_secret = creds.get("clientSecret") or ""
    if not client_id or not client_secret:
        return result_payload("error", "Paste the Intercom app Client ID and secret first.")
    state = secrets.token_urlsafe(24)
    region = str(load_config().get("region") or "US")
    url = oauth_authorize_url(client_id, state, region)
    open_browser(url)
    print(url, file=sys.stderr, flush=True)
    code, error = wait_for_oauth_code(state)
    if error and not code:
        return result_payload("error", error)
    if not code:
        return result_payload("error", "Intercom did not return an authorization code.")
    try:
        token = exchange_oauth_code(code, client_id, client_secret)
    except ApiError as error:
        return result_payload("error", str(error))
    saved = save_token(token, token_file)
    if saved.get("state") != "saved":
        return saved
    identified = False
    for try_region in region_order(region):
        me = try_identify(token, try_region)
        if not me:
            continue
        persist_admin(me)
        identified = True
        break
    if not identified:
        return result_payload(
            "saved",
            "Signed in, but could not read the teammate profile. Grant Read admins and sign in again.",
        )
    config = load_config()
    return result_payload(
        "saved",
        "Signed in with Intercom.",
        adminId=str(config.get("adminId") or ""),
        adminName=str(config.get("adminName") or ""),
        adminEmail=str(config.get("adminEmail") or ""),
        workspaceId=str(config.get("workspaceId") or ""),
    )


def parse_reply_markdown(raw: object) -> str:
    text = str(raw or "")
    stripped = text.strip()
    if stripped.startswith("{"):
        try:
            parsed = json.loads(stripped)
        except json.JSONDecodeError:
            parsed = None
        if isinstance(parsed, dict) and "body" in parsed:
            return str(parsed.get("body") or "")
    return text


def parse_seen_comments(raw: object) -> list[dict]:
    rows: list[dict] = []
    if not isinstance(raw, list):
        return rows
    for item in raw:
        if isinstance(item, str):
            comment_id = item.strip()
            if comment_id:
                rows.append({"id": comment_id, "createdAt": 0})
            continue
        if not isinstance(item, dict):
            continue
        comment_id = str(item.get("id") or "").strip()
        if not comment_id:
            continue
        rows.append({
            "id": comment_id,
            "createdAt": unix_time(item.get("createdAt") if item.get("createdAt") is not None else item.get("created_at")),
        })
    return rows


def parse_reply_request(raw: object) -> tuple[str, list[dict] | None, bool]:
    body = parse_reply_markdown(raw)
    text = str(raw or "").strip()
    if not text.startswith("{"):
        return body, None, False
    try:
        parsed = json.loads(text)
    except json.JSONDecodeError:
        return body, None, False
    if not isinstance(parsed, dict):
        return body, None, False
    seen = parse_seen_comments(parsed.get("seen")) if "seen" in parsed else None
    return body, seen, parsed.get("note") is True


def comment_messages(messages: object) -> list[dict]:
    rows: list[dict] = []
    if not isinstance(messages, list):
        return rows
    for item in messages:
        if not isinstance(item, dict):
            continue
        kind = str(item.get("kind") or "").strip().lower()
        comment_id = str(item.get("id") or "").strip()
        if not comment_id or kind not in ("customer", "teammate", "bot", "note"):
            continue
        rows.append(item)
    return rows


def newer_comments(fresh_messages: object, seen: list[dict]) -> list[dict]:
    if not seen:
        return []
    seen_ids = {str(row.get("id") or "") for row in seen if str(row.get("id") or "")}
    last_seen = 0
    for row in seen:
        created = int(row.get("createdAt") or 0)
        if created > last_seen:
            last_seen = created
    new_rows: list[dict] = []
    for msg in comment_messages(fresh_messages):
        comment_id = str(msg.get("id") or "")
        if comment_id in seen_ids:
            continue
        created = int(msg.get("createdAt") or 0)
        if seen_ids and created < last_seen:
            continue
        new_rows.append(msg)
    return new_rows


def fetch_conversation(token: str, region: str, conv_id: str) -> dict:
    payload = request_json(
        f"{api_base_for_region(region)}/conversations/"
        f"{urllib.parse.quote(conv_id, safe='')}",
        token,
    )
    return attach_missing_parts(token, region, conv_id, payload)


def reply_conversation(token_file: str | None, conversation_id: str, markdown: object) -> dict:
    token = read_token(token_file)
    if not token:
        return unconfigured_payload(token_file)
    conv_id = str(conversation_id or "").strip()
    if not CONVERSATION_ID.fullmatch(conv_id):
        return result_payload("error", "Missing conversation id.")
    source, seen, as_note = parse_reply_request(markdown)
    if not str(source or "").strip():
        return result_payload("error", "Write a message before sending.")
    body = markdown_to_html(source)
    if not body:
        return result_payload("error", "Write a message before sending.")
    config = load_config()
    last_error: ApiError | None = None
    for region in region_order(config.get("region")):
        base = api_base_for_region(region)
        try:
            me_payload = request_json(f"{base}/me", token)
        except ApiError as error:
            last_error = error
            if is_missing_permission(error):
                return missing_admin_payload()
            if is_wrong_region(error) or error.status in (401, 403, 404):
                continue
            return result_payload("error", str(error))
        me = parse_me(me_payload)
        admin_id = str(me.get("id") or "")
        if not admin_id:
            return missing_admin_payload()
        persist_admin(me)
        if me.get("region"):
            region = str(me["region"])
            base = api_base_for_region(region)
        try:
            current = fetch_conversation(token, region, conv_id)
        except ApiError as error:
            last_error = error
            if is_missing_permission(error):
                return missing_permission_payload()
            return result_payload("error", str(error))
        workspace = parse_workspace_id(
            me.get("workspaceId") or config.get("workspaceId") or workspace_from_payload(current)
        )
        conversation = normalize_thread(current, region, workspace)
        if seen and newer_comments(conversation.get("messages") or [], seen):
            try:
                save_config(region=region, workspaceId=workspace or None)
            except OSError:
                pass
            return result_payload(
                "error",
                "New comments arrived; reply was not sent.",
                inboxUrl=inbox_url(region, workspace),
                workspaceId=workspace,
                conversation=conversation,
            )
        try:
            payload = request_json(
                f"{base}/conversations/{urllib.parse.quote(conv_id, safe='')}/reply",
                token,
                method="POST",
                payload=admin_reply_body(admin_id, body, "note" if as_note else "comment"),
            )
        except ApiError as error:
            last_error = error
            if is_missing_permission(error):
                return missing_write_payload()
            return result_payload("error", str(error))
        workspace = parse_workspace_id(
            me.get("workspaceId") or workspace or workspace_from_payload(payload)
        )
        try:
            save_config(region=region, workspaceId=workspace or None)
        except OSError:
            pass
        conversation = normalize_thread(payload, region, workspace)
        if conversation.get("id") != conv_id:
            conversation = normalize_thread(
                {"id": conv_id, "conversation_parts": payload.get("conversation_parts"), "source": payload.get("source")},
                region,
                workspace,
            )
            if not conversation.get("id"):
                conversation = {"id": conv_id, "title": "", "url": conversation_url(region, workspace, conv_id), "waitingSince": 0, "messages": []}
        return result_payload(
            "ready",
            "",
            inboxUrl=inbox_url(region, workspace),
            workspaceId=workspace,
            conversation=conversation,
        )
    if last_error and is_missing_permission(last_error):
        return missing_write_payload()
    return region_failure_payload(last_error)


