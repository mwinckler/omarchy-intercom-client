            token,
        )
    except ApiError:
        return None


def merge_conversation_parts(conv: dict, extra_parts: list[dict]) -> dict:
    existing = conversation_parts_list(conv)
    seen = {str(part.get("id") or "") for part in existing if str(part.get("id") or "")}
    merged = list(existing)
    for part in extra_parts:
        if not isinstance(part, dict):
            continue
        part_id = str(part.get("id") or "")
        if part_id and part_id in seen:
            continue
        if part_id:
            seen.add(part_id)
        merged.append(part)
    row = dict(conv)
    parts = row.get("conversation_parts")
    if isinstance(parts, dict):
        parts = dict(parts)
        parts["conversation_parts"] = merged
        row["conversation_parts"] = parts
    else:
        row["conversation_parts"] = merged
    return row


def attach_missing_parts(token: str, region: str, conv_id: str, conv: dict) -> dict:
    if not isinstance(conv, dict):
        return conv
    conv_id = str(conv_id or conv.get("id") or "").strip()
    cursor = parts_next_cursor(conv)
    total = conversation_parts_total(conv)
    if not conv_id or (not cursor and (total <= 0 or total <= len(conversation_parts_list(conv)))):
        return conv
    base = api_base_for_region(region)
    pages = 0
    while cursor and pages < 10:
        pages += 1
        url = (
            f"{base}/conversations/{urllib.parse.quote(conv_id, safe='')}"
            f"?starting_after={urllib.parse.quote(cursor)}"
        )
        try:
            extra = request_json(url, token)
        except ApiError:
            break
        more = conversation_parts_list(extra)
        if not more:
            break
        conv = merge_conversation_parts(conv, more)
        nxt = parts_next_cursor(extra)
        if not nxt or nxt == cursor:
            break
        cursor = nxt
        if total and len(conversation_parts_list(conv)) >= total:
            break
    return conv


def attach_latest_messages(token: str, region: str, conversations: list[object]) -> list[object]:
    wanted = [
        item
        for item in conversations
        if isinstance(item, dict) and str(item.get("id") or "").strip()
    ]
    if not wanted:
        return conversations
    details: dict[str, dict] = {}
    workers = max(1, min(DETAIL_WORKERS, len(wanted)))
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
        futures = {
            pool.submit(fetch_conversation_detail, token, region, str(item.get("id"))): str(item.get("id"))
            for item in wanted
        }
        for future in concurrent.futures.as_completed(futures):
            conv_id = futures[future]
            try:
                payload = future.result()
            except Exception:
                continue
            if isinstance(payload, dict):
                details[conv_id] = payload
    merged: list[object] = []
    for item in conversations:
        if not isinstance(item, dict):
            merged.append(item)
            continue
        extra = details.get(str(item.get("id") or ""))
        if not extra:
            merged.append(item)
            continue
        row = dict(item)
        if extra.get("source"):
            row["source"] = extra["source"]
        if extra.get("conversation_parts") is not None:
            row["conversation_parts"] = extra["conversation_parts"]
        if extra.get("title"):
            row["title"] = extra["title"]
        for key in ("state", "open", "snoozed_until", "waiting_since", "updated_at"):
            if extra.get(key) is not None:
                row[key] = extra[key]
        merged.append(row)
    return merged


def fetch_waiting(
    token: str,
    region: str,
    workspace_id: str,
    limit: int,
    payload: dict | None = None,
    me: dict | None = None,
) -> dict:
    if payload is None:
        payload = request_json(
            f"{api_base_for_region(region)}/conversations/search",
            token,
            method="POST",
            payload=search_body(limit),
        )
    conversations = payload.get("conversations") if isinstance(payload.get("conversations"), list) else []
    payload = dict(payload)
    payload["conversations"] = attach_latest_messages(token, region, conversations)
    parsed = parse_search(payload, region, workspace_id, limit)
    try:
        counts = fetch_inbox_counts(token, region)
    except Exception:
        counts = None
    return result_payload(
        "ready",
        "",
        waitingCount=parsed["waitingCount"],
        inboxUrl=inbox_url(region, workspace_id),
        workspaceId=workspace_id,
        conversations=parsed["conversations"],
        **inbox_count_fields(counts),
        **identity_from_me(me),
    )


def search_total_count(payload: dict) -> int:
    total = payload.get("total_count") if isinstance(payload, dict) else None
    try:
        count = int(total)
    except (TypeError, ValueError):
        rows = payload.get("conversations") if isinstance(payload, dict) else []
        count = len(rows) if isinstance(rows, list) else 0
    return max(0, count)


def fetch_inbox_counts(token: str, region: str) -> dict[str, int] | None:
    counts: dict[str, int] = {}
    for mode in ("open", "closed", "snoozed"):
        try:
            payload = request_json(
                f"{api_base_for_region(region)}/conversations/search",
                token,
                method="POST",
                payload=search_inbox_body(mode, 1),
            )
        except ApiError:
            return None
        if not isinstance(payload, dict):
            return None
        counts[mode] = search_total_count(payload)
    counts["all"] = counts["open"] + counts["closed"] + counts["snoozed"]
    return counts


def inbox_count_fields(counts: dict[str, int] | None) -> dict[str, int]:
    if not counts:
        return {}
    fields: dict[str, int] = {}
    if "open" in counts:
        fields["openCount"] = counts["open"]
    if "closed" in counts:
        fields["closedCount"] = counts["closed"]
    if "snoozed" in counts:
        fields["snoozedCount"] = counts["snoozed"]
    if "all" in counts:
        fields["allCount"] = counts["all"]
    return fields


def panel_mode(value: object = None) -> str:
    if value is None:
        value = load_config().get("panel")
    return normalize_panel_mode(value)


INBOX_FILTERS = ("open", "waiting", "closed", "snoozed", "all")


def filter_mode(value: object = None) -> str:
    if value is None:
        value = load_config().get("filter")
    text = str(value or "").strip().lower()
    return text if text in INBOX_FILTERS else "open"


def viewed_conversation(value: object = None) -> str:
    if value is None:
        value = load_config().get("viewed")
    text = str(value or "").strip()
    return text if CONVERSATION_ID.fullmatch(text) else ""


def result_payload(state: str, message: str = "", **fields: object) -> dict:
    payload = {
        "state": state,
        "message": message,
        "waitingCount": 0,
        "inboxUrl": "",
        "workspaceId": "",
        "conversations": [],
        "conversation": {},
        "openCount": 0,
        "panel": panel_mode(),
        "filter": filter_mode(),
        "viewed": viewed_conversation(),
        **identity_fields(),
    }
    payload.update(fields)
    return payload


def save_token(token: str, token_file: str | None = None, workspace_id: str | None = None) -> dict:
    value = WHITESPACE.sub("", str(token or "")).strip()
    if not value:
        return result_payload("error", "Paste an Intercom access token first.")
    path = os.path.expanduser(token_file or default_token_path())
    directory = os.path.dirname(path)
    try:
        os.makedirs(directory, exist_ok=True)
        os.chmod(directory, 0o700)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(value + "\n")
        os.chmod(path, 0o600)
        if workspace_id is not None:
            workspace = parse_workspace_id(workspace_id)
            if str(workspace_id).strip() and not workspace:
                return result_payload(
                    "error",
                    "Could not read a workspace ID. Paste the Intercom inbox URL from your browser.",
                )
            if workspace:
                save_config(workspaceId=workspace)
    except OSError as error:
        return result_payload("error", f"Could not save token: {error.strerror or error}")
    return result_payload("saved", f"Saved token to {path}")


def save_panel(mode: str) -> dict:
    return save_prefs(panel=mode)


def save_prefs(panel: str = "", inbox_filter: str = "", viewed: str = "") -> dict:
    fields: dict[str, object] = {}
    if str(panel or "").strip():
        fields["panel"] = panel_mode(panel)
    if str(inbox_filter or "").strip():
        fields["filter"] = filter_mode(inbox_filter)
    viewed_id = viewed_conversation(viewed) if str(viewed or "").strip() else ""
    if viewed_id:
        fields["viewed"] = viewed_id
    if not fields:
        return result_payload("error", "Missing panel or filter.")
    try:
        save_config(**fields)
    except OSError as error:
        return result_payload("error", f"Could not save preferences: {error.strerror or error}")
    return result_payload("saved", "Saved panel preferences", **fields)


