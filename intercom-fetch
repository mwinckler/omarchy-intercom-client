def discover_workspace(token: str, region: str, conversation_ids: list[str] | None = None) -> str:
    """Read workspace id_code from Unstable conversation payloads.

    Stable conversation search omits company.app_id. Unstable includes it when a
    company is attached. Listing stays on the stable API because Unstable totals
    can differ.
    """
    base = api_base_for_region(region)
    try:
        payload = request_json(
            f"{base}/conversations/search",
            token,
            method="POST",
            payload=search_body(50),
            version=UNSTABLE_VERSION,
        )
    except ApiError:
        payload = None
    workspace = workspace_from_payload(payload)
    if workspace:
        return workspace
    for conv_id in (conversation_ids or [])[:8]:
        if not conv_id:
            continue
        try:
            one = request_json(
                f"{base}/conversations/{conv_id}",
                token,
                version=UNSTABLE_VERSION,
            )
        except ApiError:
            continue
        workspace = workspace_from_payload(one)
        if workspace:
            return workspace
    return ""


