def default_token_path() -> str:
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.path.expanduser("~"), ".config"
    )
    return os.path.join(config_home, "omarchy", "intercom-notifier", "token")


def plugin_token_path() -> str:
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "token")


def token_paths(token_file: str | None) -> list[str]:
    paths: list[str] = []
    if token_file:
        paths.append(os.path.expanduser(token_file))
    for candidate in (default_token_path(), plugin_token_path()):
        if candidate not in paths:
            paths.append(candidate)
    return paths


def read_token(token_file: str | None) -> str | None:
    env_token = os.environ.get("INTERCOM_ACCESS_TOKEN", "").strip()
    if env_token:
        return env_token
    for path in token_paths(token_file):
        try:
            with open(path, encoding="utf-8") as handle:
                token = handle.read().strip()
        except OSError:
            continue
        if token:
            return token
    return None


def api_base_for_region(region: str) -> str:
    return REGION_HOSTS.get((region or "US").upper(), REGION_HOSTS["US"])[0]


def inbox_host_for_region(region: str) -> str:
    return REGION_HOSTS.get((region or "US").upper(), REGION_HOSTS["US"])[1]


def parse_workspace_id(value: object) -> str:
    text = str(value or "").strip()
    if not text:
        return ""
    match = WORKSPACE_IN_URL.search(text)
    if match:
        text = match.group(1).strip()
    if "/" in text or text.lower() in RESERVED_WORKSPACE:
        return ""
    if not WORKSPACE_ID.fullmatch(text):
        return ""
    return text


def workspace_from_payload(payload: dict | None) -> str:
    if not isinstance(payload, dict):
        return ""
    conversations = payload.get("conversations")
    if not isinstance(conversations, list):
        conversations = [payload]
    for item in conversations:
        if not isinstance(item, dict):
            continue
        company = item.get("company") if isinstance(item.get("company"), dict) else {}
        workspace = parse_workspace_id(company.get("app_id"))
        if workspace:
            return workspace
    return ""


def inbox_url(region: str, workspace_id: str) -> str:
    workspace = parse_workspace_id(workspace_id)
    host = inbox_host_for_region(region)
    if not workspace:
        return host
    return f"{host}/a/inbox/{workspace}/inbox/shared/all"


def conversation_url(region: str, workspace_id: str, conversation_id: str) -> str:
    conv_id = str(conversation_id or "").strip()
    workspace = parse_workspace_id(workspace_id)
    if not conv_id:
        return inbox_url(region, workspace)
    if not workspace:
        return ""
    return (
        f"{inbox_host_for_region(region)}/a/inbox/{workspace}"
        f"/inbox/shared/all/conversation/{conv_id}"
    )


def strip_html(value: object) -> str:
    text = HTML_TAG.sub(" ", str(value or ""))
    text = html.unescape(text)
    return WHITESPACE.sub(" ", text).strip()


def is_safe_http_url(value: object) -> str:
    text = html.unescape(str(value or "")).strip()
    if not text or any(ch.isspace() for ch in text):
        return ""
    lower = text.lower()
    if not (lower.startswith("http://") or lower.startswith("https://")):
        return ""
    if lower.startswith("javascript:") or lower.startswith("data:"):
        return ""
    return text


def trim_url_match(value: str) -> str:
    url = str(value or "")
    while url:
        safe = is_safe_http_url(url)
        if safe:
            return safe
        trimmed = TRAILING_URL_PUNCT.sub("", url)
        if trimmed != url:
            url = trimmed
            continue
        if url[-1] in ")]}>'\"":
            url = url[:-1]
            continue
        break
    return is_safe_http_url(url)


def message_plain_text(value: object) -> str:
    text = HTML_TAG.sub(" ", str(value or ""))
    text = html.unescape(text).replace("\xa0", " ")
    return WHITESPACE.sub(" ", text).strip()


def _linkify_plain(text: str) -> str:
    parts: list[str] = []
    last = 0
    for match in BARE_URL.finditer(text):
        url = trim_url_match(match.group(0))
        if not url:
            continue
        start = match.start()
        end = start + len(url)
        if start < last:
            continue
        parts.append(html.escape(text[last:start]).replace("\n", "<br>"))
        parts.append(f'<a href="{html.escape(url, quote=True)}">{html.escape(url)}</a>')
        last = end
    parts.append(html.escape(text[last:]).replace("\n", "<br>"))
    return "".join(parts)


class MessageFormatter(HTMLParser):
    BLOCK_TAGS = {
        "p", "div", "br", "li", "ul", "ol", "h1", "h2", "h3", "h4", "h5", "h6",
        "blockquote", "tr", "table", "pre", "hr",
    }

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []
        self.bold = 0
        self.italic = 0
        self.link_stack: list[bool] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        tag = tag.lower()
        if tag == "br":
            self.parts.append("\n")
            return
        if tag in self.BLOCK_TAGS:
            self._block_break()
            return
        if tag in ("b", "strong"):
            self.bold += 1
            if self.bold == 1:
                self.parts.append("<b>")
            return
        if tag in ("i", "em"):
            self.italic += 1
            if self.italic == 1:
                self.parts.append("<i>")
            return
        if tag == "a":
            href = ""
            for name, value in attrs:
                if name.lower() == "href":
                    href = is_safe_http_url(value)
                    break
            opened = bool(href) and not any(self.link_stack)
            if opened:
                self.parts.append(f'<a href="{html.escape(href, quote=True)}">')
            self.link_stack.append(opened)

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if tag == "div":
            # Email HTML (Gmail) uses <div> as a line, matching Intercom's web inbox.
            self._block_break()
            return
        if tag in ("p", "h1", "h2", "h3", "h4", "h5", "h6", "blockquote", "pre"):
            self._paragraph_break()
            return
        if tag == "li":
            self._block_break()
            return
        if tag in ("b", "strong"):
            if self.bold <= 0:
                return
            self.bold -= 1
            if self.bold == 0:
                self.parts.append("</b>")
            return
        if tag in ("i", "em"):
            if self.italic <= 0:
                return
            self.italic -= 1
            if self.italic == 0:
                self.parts.append("</i>")
            return
        if tag == "a":
            if not self.link_stack:
                return
            if self.link_stack.pop():
                self.parts.append("</a>")

    def handle_data(self, data: str) -> None:
        text = WHITESPACE.sub(" ", str(data or "").replace("\xa0", " "))
        if text == "":
            return
        if text.strip() == "":
            if self.parts and self.parts[-1] not in (" ", "\n"):
                self.parts.append(" ")
            return
        if any(self.link_stack):
            self.parts.append(html.escape(text))
        else:
            self.parts.append(_linkify_plain(text))

    def handle_startendtag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        self.handle_starttag(tag, attrs)
        if tag.lower() != "br":
            self.handle_endtag(tag)

    def _block_break(self) -> None:
        while self.parts and self.parts[-1] == " ":
            self.parts.pop()
        if not "".join(self.parts).strip():
            return
        if self.parts and self.parts[-1] != "\n":
            self.parts.append("\n")

    def _paragraph_break(self) -> None:
        self._block_break()
        if not self.parts or self.parts[-1] != "\n":
            return
        if len(self.parts) < 2 or self.parts[-2] != "\n":
            self.parts.append("\n")

    def styled(self) -> str:
        while self.italic > 0:
            self.parts.append("</i>")
            self.italic -= 1
        while self.bold > 0:
            self.parts.append("</b>")
            self.bold -= 1
        while self.link_stack:
            if self.link_stack.pop():
                self.parts.append("</a>")
        text = "".join(self.parts)
        text = re.sub(r"\n{2,}", "\n\n", text).strip("\n")
        return text.replace("\n", "<br>")


def format_message_body(value: object) -> str:
    text = str(value or "")
    if not text.strip():
        return ""
    if HTML_MARKUP.search(text):
        formatter = MessageFormatter()
        formatter.feed(text)
        formatter.close()
        styled = formatter.styled()
    else:
        styled = _linkify_plain(text.replace("\r\n", "\n").replace("\r", "\n"))
    if not message_plain_text(styled):
        return ""
    return styled


def truncate(value: str, limit: int = SNIPPET_LIMIT) -> str:
    text = WHITESPACE.sub(" ", str(value or "")).strip()
    if len(text) <= limit:
        return text
    return text[: limit - 1].rstrip() + "…"


def search_body(limit: int) -> dict:
    per_page = max(1, min(150, int(limit)))
    return {
        "query": {
            "operator": "AND",
            "value": [
                {"field": "open", "operator": "=", "value": True},
                {"field": "state", "operator": "=", "value": "open"},
                {"field": "waiting_since", "operator": ">", "value": 0},
            ],
        },
        "pagination": {"per_page": per_page},
        "sort": {"field": "waiting_since", "order": "descending"},
    }


def search_open_body(limit: int) -> dict:
    per_page = max(1, min(150, int(limit)))
    return {
        "query": {
            "operator": "AND",
            "value": [
                {"field": "open", "operator": "=", "value": True},
                {"field": "state", "operator": "=", "value": "open"},
            ],
        },
        "pagination": {"per_page": per_page},
        "sort": {"field": "updated_at", "order": "descending"},
    }


def search_state_body(state: str, limit: int, now: float | None = None) -> dict:
    per_page = max(1, min(150, int(limit)))
    wanted = str(state or "").strip().lower()
    clauses: list[dict[str, object]] = [
        {"field": "state", "operator": "=", "value": wanted},
    ]
    if wanted == "closed" and per_page > 1:
        since = int((time.time() if now is None else now) - RECENT_INBOX_SECONDS)
        clauses.append({"field": "updated_at", "operator": ">", "value": max(0, since)})
    return {
        "query": {
            "operator": "AND",
            "value": clauses,
        },
        "pagination": {"per_page": per_page},
        "sort": {"field": "updated_at", "order": "descending"},
    }


def search_inbox_body(inbox_filter: str, limit: int) -> dict:
    mode = filter_mode(inbox_filter)
    if mode == "waiting":
        return search_body(limit)
    if mode == "closed":
        return search_state_body("closed", limit)
    if mode == "snoozed":
        return search_state_body("snoozed", limit)
    if mode == "all":
        return search_all_body(limit)
    return search_open_body(limit)


def search_all_body(limit: int = 150, starting_after: str = "") -> dict:
    per_page = max(1, min(150, int(limit)))
    pagination: dict[str, object] = {"per_page": per_page}
    cursor = str(starting_after or "").strip()
    if cursor:
        pagination["starting_after"] = cursor
    return {
        "query": {
            "operator": "OR",
            "value": [
                {"field": "state", "operator": "=", "value": "open"},
                {"field": "state", "operator": "=", "value": "closed"},
                {"field": "state", "operator": "=", "value": "snoozed"},
            ],
        },
        "pagination": pagination,
        "sort": {"field": "updated_at", "order": "descending"},
    }


def search_tokens(value: object) -> list[str]:
    return [part.lower() for part in WHITESPACE.split(str(value or "").strip().lower()) if part]


def search_remote_body(text: str, limit: int = SEARCH_LIMIT) -> dict:
    query = str(text or "").strip()
    words = search_tokens(query)[:6]
    clauses: list[dict[str, object]] = [
        {"field": "source.author.name", "operator": "~", "value": query},
        {"field": "source.author.email", "operator": "~", "value": query},
        {"field": "source.subject", "operator": "~", "value": query},
    ]
    if len(words) == 1:
        clauses.append({"field": "source.body", "operator": "=", "value": words[0]})
    elif words:
        clauses.append({
            "operator": "AND",
            "value": [{"field": "source.body", "operator": "=", "value": word} for word in words],
        })
    return {
        "query": {"operator": "OR", "value": clauses},
        "pagination": {"per_page": max(1, min(SEARCH_LIMIT, int(limit)))},
        "sort": {"field": "updated_at", "order": "descending"},
    }


def parse_me(payload: dict) -> dict:
    app = payload.get("app") if isinstance(payload.get("app"), dict) else {}
    region = str(app.get("region") or "US").upper()
    if region not in REGION_HOSTS:
        region = "US"
    email = str(payload.get("email") or "").strip()
    return {
        "id": str(payload.get("id") or ""),
        "name": str(payload.get("name") or ""),
        "email": email if "@" in email else "",
        "workspaceId": str(app.get("id_code") or ""),
        "region": region,
    }


def identity_from_me(me: object) -> dict:
